Manifest-Version: 1.0
Bundle-ManifestVersion: 2
Automatic-Module-Name: com.cthing.cmakeed.ui
Bundle-Name: %Bundle-Name
Bundle-SymbolicName: com.cthing.cmakeed.ui; singleton:=true
Bundle-Version: 1.10.0
Bundle-Activator: com.cthing.cmakeed.ui.CMakeEditorPlugin
Bundle-Vendor: %Bundle-Vendor
Bundle-Localization: plugin
Require-Bundle: com.cthing.cmakeed.core,
 org.eclipse.ui,
 org.eclipse.core.runtime,
 org.eclipse.jface.text,
 org.eclipse.ui.editors,
 org.eclipse.ui.workbench.texteditor,
 org.eclipse.help,
 org.eclipse.e4.ui.css.swt.theme
Bundle-ActivationPolicy: lazy
Bundle-RequiredExecutionEnvironment: JavaSE-11
Import-Package: com.cthing.cmakeed.ui.editor,
 org.eclipse.core.resources,
 org.eclipse.debug.core,
 org.eclipse.debug.core.model,
 org.eclipse.debug.ui.actions,
 org.eclipse.ui.dialogs,
 org.eclipse.ui.ide,
 org.eclipse.ui.plugin,
 org.osgi.framework
Export-Package: com.cthing.cmakeed.ui.editor;
  uses:="com.cthing.cmakeed.core.commands,
   com.cthing.cmakeed.core.properties,
   com.cthing.cmakeed.core.reservedwords,
   com.cthing.cmakeed.core.variables,
   org.eclipse.core.filebuffers,
   org.eclipse.core.runtime,
   org.eclipse.jface.preference,
   org.eclipse.jface.resource,
   org.eclipse.jface.text,
   org.eclipse.jface.text.contentassist,
   org.eclipse.jface.text.presentation,
   org.eclipse.jface.text.rules,
   org.eclipse.jface.text.source,
   org.eclipse.jface.text.templates,
   org.eclipse.jface.text.templates.persistence,
   org.eclipse.jface.util,
   org.eclipse.swt.graphics,
   org.eclipse.swt.widgets,
   org.eclipse.ui,
   org.eclipse.ui.editors.text,
   org.eclipse.ui.texteditor",
 com.cthing.cmakeed.ui.prefs;
  uses:="org.eclipse.core.runtime.preferences,
   org.eclipse.jface.preference,
   org.eclipse.swt.widgets,
   org.eclipse.ui,
   org.eclipse.ui.texteditor.templates"
